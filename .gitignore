
# Node.js dependencies
node_modules/
**/node_modules/

# Python virtual environments
.venv/
venv/
**/.venv/
**/venv/

# Python cache files
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Environment variables and secrets
.env
.env.*
!.env.example

# Frontend build output
frontend/dist/

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Stray logs at the repository root (temporary). The logs/ directory is tracked
# on purpose: its files are cited as evidence in docs/05 and CHANGES_MADE.md.
/*.log
!logs/**

# Large raw datasets - downloaded by realdata/fetch_data.py, never committed.
# (realdata/.gitignore already excludes data/raw/*; repeated here for clarity.)
realdata/data/raw/*
!realdata/data/raw/.gitkeep

# Secrets and keys
*.pem
*.key
id_rsa*
credentials.json
secrets.json

# Build / tooling
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
*.egg-info/
